{
    "name": "shimonewman/streaming",
    "description": "FFmpeg-based ABR packaging library for HLS and DASH",
    "type": "library",
    "keywords": ["hls", "dash", "ffmpeg", "streaming", "abr", "adaptive"],
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Shimon Newman",
            "email": "shimon@appwrite.io"
        }
    ],
    "autoload": {
        "psr-4": {"Utopia\\Streaming\\": "src/Streaming"}
    },
    "autoload-dev": {
        "psr-4": {"Utopia\\Tests\\": "tests/Streaming"}
    },
    "scripts":{
        "test": "phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "require": {
        "php": "^8.1",
        "php-ffmpeg/php-ffmpeg": "1.*.*"
    },
    "require-dev": {
        "swoole/ide-helper": "4.8.8",
        "phpunit/phpunit": "^9.5.5",
        "laravel/pint": "^0.2.3",
        "phpstan/phpstan": "^1.8"
    },
    "suggest": {
        "ext-swoole": "Needed to support Swoole."
    }
}
